#cloud-config
hostname: unprovisioned-pi
manage_etc_hosts: true

users:
  - name: culture
    groups: [adm, sudo, netdev, audio, video, plugdev, dialout, gpio, spi, i2c, render]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - gh:jmeed
      - gh:k0s

packages:
  - curl

write_files:
  - path: /usr/local/sbin/ssh_key_update.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      # Script to update SSH keys from S3 location
      # This script is run automatically at boot and on a timer

      LOG_FILE="/var/log/ssh_key_update.log"
      SSH_KEY_URL="https://s3.us-west-2.amazonaws.com/developer.ssh.keys/culture.public.keys"
      USER="culture"

      # Resolve home dir at runtime (no ansible vars)
      USER_HOME="$(getent passwd "$USER" | cut -d: -f6)"
      AUTHORIZED_KEYS_FILE="${USER_HOME}/.ssh/authorized_keys"

      log_message() {
          echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
          logger -t ssh_key_update "$1" || true
      }

      log_message "Starting SSH key update process"

      # Create .ssh directory if it doesn't exist
      mkdir -p "${USER_HOME}/.ssh"
      chmod 700 "${USER_HOME}/.ssh"
      chown "${USER}:${USER}" "${USER_HOME}/.ssh"

      # Download keys from S3
      log_message "Downloading SSH keys from $SSH_KEY_URL"
      if curl -fsSL -o /tmp/ssh_keys.tmp "$SSH_KEY_URL"; then
          log_message "Successfully downloaded SSH keys"

          # Backup existing authorized_keys
          if [ -f "$AUTHORIZED_KEYS_FILE" ]; then
              cp "$AUTHORIZED_KEYS_FILE" "${AUTHORIZED_KEYS_FILE}.backup.$(date +%Y%m%d-%H%M%S)"
              log_message "Backed up existing authorized_keys file"
          fi

          # Optional: basic sanity filter (prevents HTML/garbage from nuking access)
          TMP2="$(mktemp)"
          grep -E '^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp256|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) ' /tmp/ssh_keys.tmp > "$TMP2" || true
          mv "$TMP2" /tmp/ssh_keys.tmp

          # Update authorized_keys atomically
          mv /tmp/ssh_keys.tmp "$AUTHORIZED_KEYS_FILE"
          chmod 600 "$AUTHORIZED_KEYS_FILE"
          chown "${USER}:${USER}" "$AUTHORIZED_KEYS_FILE"

          log_message "SSH keys updated successfully"
      else
          log_message "Failed to download SSH keys from $SSH_KEY_URL"
          exit 1
      fi

      log_message "SSH key update process completed"

  - path: /usr/local/sbin/display-ip-info.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      # Display hostname and every physical interface's IP on the console

      HOSTNAME=$(hostname)

      # Physical NICs have a device symlink to their backing bus device; lo,
      # docker0, veth* and br-* do not. Falls back to everything-but-lo so the
      # banner can never come out empty.
      list_interfaces() {
          local dev name found=""
          for dev in /sys/class/net/*; do
              if [ ! -e "$dev" ]; then continue; fi
              name=${dev##*/}
              if [ -e "$dev/device" ]; then found="${found}${name} "; fi
          done
          if [ -z "$found" ]; then
              for dev in /sys/class/net/*; do
                  if [ ! -e "$dev" ]; then continue; fi
                  name=${dev##*/}
                  if [ "$name" != "lo" ]; then found="${found}${name} "; fi
              done
          fi
          printf '%s' "$found"
      }

      # Global scope only, which drops IPv6 link-local (fe80::) and IPv4 169.254.*
      addrs_for() {
          local name="$1" addr out=""
          for addr in $( { ip -o -4 addr show dev "$name" scope global; \
                           ip -o -6 addr show dev "$name" scope global; } 2>/dev/null \
                         | awk '{print $4}' || true ); do
              if [ -n "$out" ]; then out="${out}, ${addr}"; else out="$addr"; fi
          done
          printf '%s' "$out"
      }

      # Default gateway for this interface, if it owns a default route
      gw_for() {
          local name="$1" gw out=""
          for gw in $( { ip -4 route show default dev "$name"; \
                         ip -6 route show default dev "$name"; } 2>/dev/null \
                       | awk '$2=="via"{print $3}' || true ); do
              if [ -n "$out" ]; then out="${out}, ${gw}"; else out="$gw"; fi
          done
          printf '%s' "$out"
      }

      has_any_address() {
          local name
          for name in $(list_interfaces); do
              if [ -n "$(addrs_for "$name")" ]; then return 0; fi
          done
          return 1
      }

      # Wait up to 30s for the first address, then let slower interfaces settle
      for _ in $(seq 1 30); do
          if has_any_address; then break; fi
          sleep 1
      done
      sleep 3

      MSG="\n============================================"
      MSG+="\n  Hostname : ${HOSTNAME}"
      SUMMARY=""
      for IFACE in $(list_interfaces); do
          ADDR=$(addrs_for "$IFACE")
          STATE=$(cat "/sys/class/net/${IFACE}/operstate" 2>/dev/null || echo unknown)
          GW=$(gw_for "$IFACE")
          if [ -z "$ADDR" ]; then ADDR="no IP"; fi
          DETAIL="$STATE"
          if [ -n "$GW" ]; then DETAIL="${DETAIL}, gw ${GW}"; fi
          MSG+="\n$(printf '  %-8s : %s (%s)' "$IFACE" "$ADDR" "$DETAIL")"
          if [ -n "$SUMMARY" ]; then SUMMARY="${SUMMARY}; "; fi
          SUMMARY="${SUMMARY}${IFACE}=${ADDR}"
          if [ -n "$GW" ]; then SUMMARY="${SUMMARY} gw ${GW}"; fi
      done
      MSG+="\n============================================\n"

      # Print to all consoles
      echo -e "$MSG" > /dev/console 2>/dev/null || true
      echo -e "$MSG" | wall 2>/dev/null || true

      # Update /etc/issue so it shows on the login prompt too
      cat > /etc/issue <<ISSUE
      Raspberry Pi — \n
      IP: \4
      ISSUE

      logger -t display-ip-info "Hostname: ${HOSTNAME}, ${SUMMARY:-no interfaces}"

  - path: /etc/systemd/system/display-ip-info.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Display hostname and IP on console at boot
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/display-ip-info.sh

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/ssh-key-update.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Update SSH authorized_keys for culture from S3 URL
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/ssh_key_update.sh
      Nice=10

  - path: /etc/systemd/system/ssh-key-update.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Run ssh-key-update at boot and every 30 minutes

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=30min
      Persistent=true

      [Install]
      WantedBy=timers.target

runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, display-ip-info.service]
  - [systemctl, enable, --now, ssh-key-update.timer]
  # Run once immediately on first boot too:
  - [systemctl, start, ssh-key-update.service]
  - [reboot]
